# ══════════════════════════════════════════════════════════════════
# Forex RL Bot — .gitignore
# ══════════════════════════════════════════════════════════════════

# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-log.txt
pip-delete-this-directory.txt

# ── Virtual environments ──────────────────────────────────────────
venv/
env/
.venv/
.env/
ENV/

# ── Data — raw CSV files and processed features ───────────────────
# Raw broker data should not be committed (large files, may be proprietary)
data/*.csv
data/*.txt
data/*.xlsx

# Processed feature files (regenerated by: python run.py features)
data/processed/
*.pkl
*.parquet
*.feather
*.h5
*.hdf5

# ── Trained models ────────────────────────────────────────────────
# Models can be very large (100MB+), regenerated by: python run.py train
models/
*.zip

# ── TensorBoard logs ──────────────────────────────────────────────
logs/
runs/
tensorboard/
events.out.tfevents.*

# ── IDE and editor files ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Jupyter notebooks ─────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Environment variables and secrets ────────────────────────────
.env
.env.local
secrets.py
api_keys.py

# ── OS files ─────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Desktop.ini
$RECYCLE.BIN/

# ── Test and coverage ─────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Temporary and output files ────────────────────────────────────
*.tmp
*.bak
*.orig
chart.html
*.html.bak

# ── What IS committed (override rules above if needed) ────────────
# Keep the data directory structure but not the data itself
!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep
!logs/.gitkeep